{
    "name": "banyancms/filament-flow-builder",
    "description": "A flexible, card-based workflow builder for any Filament v5 panel: define step types and conditions in code, let people design their own flows. Part of Banyan, usable without it.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "laravel",
        "workflow",
        "approval",
        "flow builder",
        "banyan"
    ],
    "homepage": "https://github.com/BanyanCMS/banyan",
    "support": {
        "issues": "https://github.com/BanyanCMS/banyan/issues",
        "source": "https://github.com/BanyanCMS/banyan",
        "security": "https://github.com/BanyanCMS/banyan/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Banyan\\FilamentFlowBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Banyan\\FilamentFlowBuilder\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Banyan\\FilamentFlowBuilder\\Examples\\": "examples/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Banyan\\FilamentFlowBuilder\\FlowBuilderServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench filament:assets",
            "@php vendor/bin/testbench serve --port=8090"
        ],
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
